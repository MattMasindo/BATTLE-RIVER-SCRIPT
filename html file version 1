function lget(k, fallback) { try { var v = localStorage.getItem(k); return v ? JSON.parse(v) : fallback; } catch (e) { return fallback; } }
function lset(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }

function fill(text, name) {
  var n = (name || "").trim();
  return text.replace(/\{name\}/g, n || "friend");
}

function copyText(text, done) {
  function fallback() {
    try {
      var ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.top = "-1000px";
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, text.length);
      var ok = document.execCommand("copy");
      document.body.removeChild(ta);
      done(ok);
    } catch (e) { done(false); }
  }
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(function () { done(true); }, fallback);
  } else { fallback(); }
}

function App() {
  var convosState = useState(lget("br-convos", [])); var convos = convosState[0], setConvos = convosState[1];
  var activeState = useState(null); var activeId = activeState[0], setActiveId = activeState[1];
  var newNameState = useState(""); var newName = newNameState[0], setNewName = newNameState[1];
  var toastState = useState(null); var toast = toastState[0], setToast = toastState[1];

  useEffect(function () { lset("br-convos", convos); }, [convos]);

  function flash(msg) {
    setToast({ msg: msg, id: Date.now() });
    setTimeout(function () { setToast(null); }, 1600);
  }

  var active = null;
  for (var i = 0; i < convos.length; i++) { if (convos[i].id === activeId) active = convos[i]; }

  function startNew() {
    var nm = newName.trim();
    if (!nm) { flash("Enter the client's name first"); return; }
    var convo = { id: String(Date.now()), name: nm, step: "start", updated: Date.now() };
    setConvos([convo].concat(convos));
    setActiveId(convo.id);
    setNewName("");
  }

  function goTo(stepKey) {
    if (stepKey === "home") { setActiveId(null); return; }
    setConvos(convos.map(function (c) {
      return c.id === activeId ? Object.assign({}, c, { step: stepKey, updated: Date.now() }) : c;
    }));
  }

  function removeConvo(id) {
    setConvos(convos.filter(function (c) { return c.id !== id; }));
    if (activeId === id) setActiveId(null);
  }

  var toastEl = toast ? h("div", {
    key: toast.id,
    className: "flash fixed left-0 right-0 flex justify-center z-50",
    style: { bottom: "28px", pointerEvents: "none" }
  }, h("div", {
    style: { background: C.ember, color: "#fff" },
    className: "px-5 py-2.5 rounded-full text-sm font-medium shadow-lg"
  }, toast.msg)) : null;

  if (!active) {
    return h("div", { style: { background: C.bg, minHeight: "100vh", color: C.text } },
      h(HomeScreen, {
        convos: convos, newName: newName, setNewName: setNewName,
        onStart: startNew, onOpen: setActiveId, onRemove: removeConvo
      }),
      toastEl
    );
  }

  return h("div", { style: { background: C.bg, minHeight: "100vh", color: C.text } },
    h(StepScreen, { convo: active, onGo: goTo, onHome: function () { setActiveId(null); }, onFlash: flash }),
    toastEl
  );
}

