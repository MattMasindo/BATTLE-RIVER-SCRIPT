      h("div", { className: "font-display text-2xl leading-tight" }, convo.name),
      h("div", { style: { color: C.muted }, className: "text-sm mt-0.5" }, step.title)
    ),

    h("div", { className: "px-5 pt-5" },
      step.note && h("div", {
        style: { background: C.surfaceAlt, borderColor: C.emberDim, color: C.emberSoft },
        className: "rounded-xl border p-3.5 text-[13px] leading-relaxed mb-4"
      }, step.note),

      step.scripts.length > 0 && h("div", { className: "space-y-3 mb-6" },
        step.scripts.map(function (s, idx) {
          var isCopied = copiedIdx === idx;
          return h("div", {
            key: idx,
            style: { background: C.surface, borderColor: isCopied ? C.ember : C.line },
            className: "rounded-2xl border overflow-hidden"
          },
