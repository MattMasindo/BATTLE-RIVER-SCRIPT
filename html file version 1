          },
            h("span", null, ch.label),
            h("span", { style: { color: C.muted } }, "\u203A")
          );
        })
      ),

      convo.step !== "start" && h("button", {
        onClick: function () { onGo("start"); },
        style: { color: C.muted },
        className: "w-full mt-6 py-3 text-sm font-mono active:opacity-60"
      }, "restart this conversation")
    )
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(h(App));
})();
</script>
</body>
</html>
