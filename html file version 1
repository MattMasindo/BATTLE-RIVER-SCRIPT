    var out = fill(text, convo.name);
    copyText(out, function (ok) {
      if (ok) {
        setCopiedIdx(idx);
        setTimeout(function () { setCopiedIdx(null); }, 1800);
        onFlash("Copied \u2014 paste sa Messenger");
      } else {
        onFlash("Couldn't copy \u2014 long-press the text instead");
      }
    });
  }

